{
  "version": 6,
  "configurePresets": [
    {
      "name": "x64-release",
      "displayName": "x64 Release (MSVC + vcpkg static)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    }
  ],
  "buildPresets": [
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
