        BEGIN
            VALUE "CompanyName", "CTS4P project"
            VALUE "FileDescription", "CTS4P (Co-op The Sims 4 Players) native core"
            VALUE "FileVersion", "0.5.0"
            VALUE "InternalName", "winmm"
            VALUE "OriginalFilename", "winmm.dll"
            VALUE "ProductName", "cts4p"
            VALUE "ProductVersion", "0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
